# Másold át `secrets.properties` néven, és írd át a saját értékeidre:
#   cp secrets.properties.example secrets.properties
# A secrets.properties a .gitignore-ban van, sosem kerül fel a repóba.
#
# Ezek csak *alapértelmezések*: a telepített appban a Beállítások képernyőn
# bármikor felülírhatók, és ott is tárolódnak. Ha a fájl hiányzik, az app
# fordul, csak üres szervercímmel indul.

# A backend elérhetősége a telefonról. Tailscale használatakor a gép tailnet
# IP-je vagy a MagicDNS neve, egyébként a LAN-os cím.
motor.defaultBaseUrl=http://192.168.0.10:8787

# A szerverrel megosztott token (a server/.env MOTOR_TOKEN értékével azonos).
motor.defaultToken=
