# Másold át `.env` néven, és töltsd ki a saját értékeiddel:
#   cp .env.example .env
# A `.env` a .gitignore-ban van, sosem kerül fel a repóba.

# Megosztott token: a telefon ezt küldi az X-Motor-Token fejlécben.
# Kötelező, alapértelmezett értéke szándékosan nincs. Generálás:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
MOTOR_TOKEN=

# Waze (rendőrök, balesetek) – opcionális, nélküle a réteg kimarad.
WAZE_API_KEY=
# Másik szolgáltatóhoz: WAZE_API_URL, WAZE_KEY_HEADER, WAZE_API_HOST, WAZE_COUNTRY

# Hálózat – az alapértelmezés minden interfészen figyel a 8787-es porton.
#PORT=8787
#HOST=0.0.0.0

# Helyi Valhalla útvonaltervező.
#VALHALLA_URL=http://127.0.0.1:8002

# Az önteszt mintaterülete (alapértelmezés: Budapest belváros, semleges pont).
#SELFTEST_LAT=47.4979
#SELFTEST_LON=19.0402
