<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wStatsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_stats_title"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/wStatsLast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wStatsDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0 m"
            android:textColor="@color/brand"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wStatsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/WidgetStatCell">

            <TextView
                style="@style/WidgetStatLabel"
                android:text="@string/widget_stats_month" />

            <TextView
                android:id="@+id/wStatsMonth"
                style="@style/WidgetStatValue"
                android:text="0 m" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetStatCell">

            <TextView
                style="@style/WidgetStatLabel"
                android:text="@string/label_max_speed" />

            <TextView
                android:id="@+id/wStatsMaxSpeed"
                style="@style/WidgetStatValue"
                android:text="0,0 km/h" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetStatCell">

            <TextView
                style="@style/WidgetStatLabel"
                android:text="@string/label_max_elevation" />

            <TextView
                android:id="@+id/wStatsElevation"
                style="@style/WidgetStatValue"
                android:text="0 m" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
