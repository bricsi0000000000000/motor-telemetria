<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/wInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/status_idle"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="0,0 km/h"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/wBtnToggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button_primary"
        android:contentDescription="@string/action_start"
        android:padding="10dp"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/wBtnStop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/action_stop"
        android:padding="12dp"
        android:src="@drawable/ic_stop_widget"
        android:visibility="gone" />

</LinearLayout>
