<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/title_stats" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmptyStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/stats_empty"
                android:visibility="gone" />

            <!-- Összesítés -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StatsCard">

                <LinearLayout style="@style/StatsCardContent">

                    <TextView style="@style/StatsCardTitle" android:text="@string/stats_totals" />

                    <LinearLayout style="@style/StatsRow">

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_track_count" />
                            <TextView android:id="@+id/tvTrackCount" style="@style/StatValue" android:text="0" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_total_distance" />
                            <TextView android:id="@+id/tvTotalDistance" style="@style/StatValue" android:text="0 m" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_total_time" />
                            <TextView android:id="@+id/tvTotalDuration" style="@style/StatValue" android:text="0 p" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/StatsRow">

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_moving_time" />
                            <TextView android:id="@+id/tvTotalMoving" style="@style/StatValue" android:text="0 p" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_avg_speed" />
                            <TextView android:id="@+id/tvAvgSpeed" style="@style/StatValue" android:text="0,0 km/h" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_max_speed" />
                            <TextView android:id="@+id/tvTopSpeed" style="@style/StatValue" android:text="0,0 km/h" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/StatsRow">

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_max_elevation" />
                            <TextView android:id="@+id/tvTotalElevation" style="@style/StatValue" android:text="0 m" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_avg_distance" />
                            <TextView android:id="@+id/tvAvgDistance" style="@style/StatValue" android:text="0 m" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatCell">
                            <TextView style="@style/StatLabel" android:text="@string/label_first_ride" />
                            <TextView android:id="@+id/tvFirstRide" style="@style/StatValue" android:text="—" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rekordok -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StatsCard">

                <LinearLayout style="@style/StatsCardContent">

                    <TextView style="@style/StatsCardTitle" android:text="@string/stats_records" />

                    <TextView style="@style/StatLabel" android:text="@string/label_longest_ride" />

                    <TextView
                        android:id="@+id/tvLongest"
                        style="@style/StatValue"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/StatLabel"
                        android:layout_marginTop="10dp"
                        android:text="@string/label_fastest_ride" />

                    <TextView
                        android:id="@+id/tvFastest"
                        style="@style/StatValue"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Túrák elemzése: szakaszok és sebességhatár túránként -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StatsCard">

                <LinearLayout style="@style/StatsCardContent">

                    <TextView style="@style/StatsCardTitle" android:text="@string/stats_analysis" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:alpha="0.6"
                        android:text="@string/stats_analysis_hint"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/analysisList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvAnalysisProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.7"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFetchAnalyses"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/action_fetch_analyses" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Havi bontás -->
            <com.google.android.material.card.MaterialCardView
                style="@style/StatsCard">

                <LinearLayout style="@style/StatsCardContent">

                    <TextView style="@style/StatsCardTitle" android:text="@string/stats_months" />

                    <TextView
                        android:id="@+id/tvMonthsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:paddingVertical="8dp"
                        android:text="@string/no_data"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/monthContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
